{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isBoolean()"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["lastLoginAt", "lastSeenAt", "online", "createdAt", "vipUntil", "blocked"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "uid": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists()))",
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "displayName": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists()))",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists()))",
          ".validate": "newData.isString() && newData.val().length <= 180"
        },
        "photoUrl": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists()))",
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "createdAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.exists()))",
          ".validate": "newData.isNumber()"
        },
        "lastLoginAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists()))",
          ".validate": "newData.isNumber()"
        },
        "online": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid)",
          ".validate": "newData.isBoolean()"
        },
        "lastSeenAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid)",
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists()))",
          ".validate": "newData.isNumber()"
        },
        "blocked": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isBoolean()"
        },
        "blockReason": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "blockedAt": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        },
        "blockedBy": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isString()"
        },
        "role": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isString()"
        },
        "vipPlan": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isString()"
        },
        "vipGrantedAt": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        },
        "vipRevokedAt": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        },
        "vipUntil": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        },
        "adsDisabledUntil": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        },
        "vipGrantedBy": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isString()"
        },
        "$other": { ".validate": false }
      }
    },
    "episode_unlocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
